{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2023",

    "rootDir": "./src",
    "outDir": "./dist",

    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,

    "sourceMap": true,
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,

    "types": ["node"]
  }
}
